# Bank Interest Calculator

# Input
principal = float(input("Enter Principal Amount: "))
rate = float(input("Enter Annual Interest Rate (%): "))
time = float(input("Enter Time (in years): "))

# Simple Interest
simple_interest = (principal * rate * time) / 100

# Compound Interest
amount = principal * (1 + rate / 100) ** time
compound_interest = amount - principal

# Display Results
print("\n------ Bank Interest Calculator ------")
print("Principal Amount      : Rs.", principal)
print("Rate of Interest      :", rate, "%")
print("Time                  :", time, "Years")
print("Simple Interest       : Rs.", simple_interest)
print("Compound Interest     : Rs.", compound_interest)
print("Total Amount (CI)     : Rs.", amount)
